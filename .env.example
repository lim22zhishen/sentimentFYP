# Copy this file to ".env" and fill in your token.
# The .env file is gitignored and never committed — keep real secrets there,
# NOT in this template.

# HuggingFace access token — used to download the gated pyannote
# speaker-diarization model (free).
# 1. Create a token: https://huggingface.co/settings/tokens
# 2. Accept the model terms: https://huggingface.co/pyannote/speaker-diarization-3.1
HUGGINGFACE_TOKEN=

# Optional: Whisper model size for transcription. Defaults to "large-v3" on a
# GPU and "small" on CPU. Smaller = faster and less memory, but less accurate:
# tiny, base, small, medium, large-v3, turbo
# ASR_MODEL=medium
